{
	"openapi": "3.0.2",
	"info": {
		"title": "mia-deps-checker",
		"version": "1.4.0"
	},
	"paths": {
		"/mia-deps-checker/api/descriptor": {
			"get": {
				"description": "",
				"summary": "Plugin's descriptor",
				"operationId": "getPluginDescriptor",
				"responses": {
					"200": {
						"description": "Plugin's descriptor",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-deps-checker/api/status": {
			"get": {
				"description": "",
				"summary": "Plugin's status",
				"operationId": "getPluginStatus",
				"responses": {
					"200": {
						"description": "Plugin's status",
						"content": {
							"application/json": {
								"schema": {
									"type": "string",
									"enum": [ "ENABLED", "INITIALIZED", "RELEASED" ]
								}
							}
						}
					},
					"404": {
						"description": "The plugin is not enabled (=RELEASED)",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},

		"/mia-deps-checker/public/index.html": {
			"get": {
				"description": "",
				"summary": "Plugin's front",
				"operationId": "getFrontIndex",
				"responses": {
					"200": {
						"description": "Plugin's front",
						"content": {
							"text/html": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-deps-checker/public/bundle.min.js": {
			"get": {
				"description": "",
				"summary": "Plugin's front app",
				"operationId": "getFrontApp",
				"responses": {
					"200": {
						"description": "Plugin's front app",
						"content": {
							"application/javascript": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-deps-checker/public/bundle.min.js.map": {
			"get": {
				"description": "",
				"summary": "Plugin's front app map",
				"operationId": "getFrontAppMap",
				"responses": {
					"200": {
						"description": "Plugin's front app",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"additionalProperties": true
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},

		"/mia-deps-checker/api/users": {
			"get": {
				"description": "",
				"summary": "Get all registered users",
				"operationId": "getUsers",
				"responses": {
					"200": {
						"description": "Users",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"uniqueItems": true,
									"items": {
										"$ref": "#/components/schemas/User"
									}
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			},
			"put": {
				"description": "",
				"summary": "Add a user",
				"operationId": "addUser",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/User"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "User added",
						"content": {
							"application/json": {}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			},
			"delete": {
				"description": "",
				"summary": "Delete a user",
				"operationId": "deleteUser",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/User"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "User added",
						"content": {
							"application/json": {}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-deps-checker/api/repositories/{user}": {
			"get": {
				"description": "",
				"summary": "Get all repositories by user",
				"operationId": "getRepositoriesByUser",
				"parameters": [
					{
						"name": "user",
						"in": "path",
						"required": true,
						"schema": {
							"$ref": "#/components/schemas/User"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Repositories",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"uniqueItems": true,
									"description": "List of repositories",
									"items": {
										"$ref": "#/components/schemas/Repository"
									}
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-deps-checker/api/analyze/node-engine": {
			"post": {
				"description": "",
				"summary": "Analyze a package's node engine",
				"operationId": "analyzePackageNodeEngine",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"description": "Package URL",
								"properties": {
									"package_url": {
										"type": "string"
									}
								},
								"required": [ "package_url" ]
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Analyze result",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/AnalyzeNodeEngineResult"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		},
		"/mia-deps-checker/api/analyze/dependencies": {
			"post": {
				"description": "",
				"summary": "Analyze a package's dependencies",
				"operationId": "analyzePackageDependencies",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"description": "Package URL",
								"properties": {
									"package_url": {
										"type": "string"
									}
								},
								"required": [ "package_url" ]
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Analyze result",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/AnalyzeDependenciesResult"
								}
							}
						}
					},
					"default": {
						"description": "An error occurred",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"PluginName": {
				"type": "string",
				"enum": [ "mia-deps-checker" ]
			},
			"Error": {
				"type": "object",
				"description": "JSON Error description",
				"properties": {
					"code": {
						"type": "string"
					},
					"message": {
						"type": "string"
					}
				},
				"required": [ "code", "message" ]
			},
			"User": {
				"type": "string"
			},
			"Repository": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string"
					},
					"full_name": {
						"type": "string"
					},
					"html_url": {
						"type": "string"
					},
					"package_url": {
						"type": "string"
					},
					"archived": {
						"type": "boolean"
					},
					"disabled": {
						"type": "boolean"
					},
					"language": {
						"type": "string"
					},
					"watchers_count": {
						"type": "number"
					},
					"open_issues_count": {
						"type": "number"
					}
				},
				"required": [ "name", "full_name", "html_url", "package_url", "archived", "disabled", "language", "watchers_count", "open_issues_count" ]
			},
			"AnalyzeNodeEngineResult": {
				"type": "object",
				"properties": {
					"result": {
						"type": "boolean"
					},
					"message": {
						"type": "string"
					}
				},
				"required": [ "result", "message" ]
			},
			"AnalyzeDependenciesResult": {
				"type": "object",
				"properties": {
					"result": {
						"type": "boolean"
					},
					"results": {
						"type": "array",
						"uniqueItems": true,
						"items": {
							"type": "object",
							"properties": {
								"name": {
									"type": "string"
								},
								"version": {
									"type": "string"
								},
								"dev": {
									"type": "boolean"
								},
								"optional": {
									"type": "boolean"
								},
								"path": {
									"type": "string"
								},
								"time": {
									"type": "string"
								},
								"result": {
									"type": "string",
									"enum": [ "success", "warning", "fail_patch", "fail_minor", "fail_major" ]
								},
								"message": {
									"type": "string"
								}
							},
							"required": [ "name", "version", "dev", "optional", "path", "time", "result", "message" ]
						}
					}
				},
				"required": [ "result", "results" ]
			},
			"PushEventPluginInitialized": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "initialized" ]
					}
				},
				"required": [ "id", "plugin", "command" ]
			},
			"PushEventPluginReleased": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "released" ]
					}
				},
				"required": [ "id", "plugin", "command" ]
			},
			"PushEventPluginError": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "error" ]
					},
					"data": {
						"$ref": "#/components/schemas/Error"
					}
				},
				"required": [ "id", "plugin", "command", "data" ]
			},
			"PushEventUserAdded": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "add-user" ]
					},
					"data": {
						"$ref": "#/components/schemas/User"
					}
				},
				"required": [ "id", "plugin", "command", "data" ]
			},
			"PushEventUserDeleted": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"plugin": {
						"$ref": "#/components/schemas/PluginName"
					},
					"command": {
						"type": "string",
						"enum": [ "delete-user" ]
					},
					"data": {
						"$ref": "#/components/schemas/User"
					}
				},
				"required": [ "id", "plugin", "command", "data" ]
			}
		}
	},
	"servers": [
		{
			"url": "http://localhost:8000/",
			"description": "test server"
		}
	]
}
